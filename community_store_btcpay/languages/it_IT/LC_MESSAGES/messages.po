msgid "BTCPay Server payment method for Community Store."
msgstr "Metodo di pagamento BTCPay Server per Community Store."

msgid "BTCPay Server Payment Method"
msgstr "Metodo di pagamento BTCPay Server"

msgid "Not configured"
msgstr "Non configurato"

msgid "BTCPay Server URL must be set."
msgstr "L’URL di BTCPay Server deve essere specificato."

msgid "BTCPay Server URL must be a valid URL."
msgstr "L’URL di BTCPay Server deve essere un URL valido."

msgid "BTCPay Server Store ID must be set."
msgstr "L’ID dello store BTCPay Server deve essere specificato."

msgid "BTCPay Server API key must be set."
msgstr "La chiave API di BTCPay Server deve essere specificata."

msgid "BTCPay Server webhook secret must be set."
msgstr "Il segreto webhook di BTCPay Server deve essere specificato."

msgid "Community Store currency must be configured before enabling BTCPay Server."
msgstr "La valuta di Community Store deve essere configurata prima di abilitare BTCPay Server."

msgid "Unable to start the BTCPay Server payment. Please return to checkout and try again."
msgstr "Impossibile avviare il pagamento BTCPay Server. Torna al checkout e riprova."

#, php-format
msgid "Payments use the Community Store currency: %s. Currency conversion is not performed by this payment method."
msgstr "I pagamenti utilizzano la valuta configurata in Community Store: %s. Questo metodo di pagamento non esegue conversioni di valuta."

msgid "BTCPay Server URL"
msgstr "URL di BTCPay Server"

msgid "BTCPay Server Store ID"
msgstr "ID dello store BTCPay Server"

msgid "BTCPay Server API key"
msgstr "Chiave API di BTCPay Server"

msgid "An API key is already configured. Leave this field blank to keep it unchanged."
msgstr "È già configurata una chiave API. Lascia vuoto questo campo per mantenerla invariata."

msgid "Enter an API key that can create and view invoices for this BTCPay Server store."
msgstr "Inserisci una chiave API autorizzata a creare e visualizzare le fatture per questo store BTCPay Server."

msgid "BTCPay Server webhook secret"
msgstr "Segreto webhook di BTCPay Server"

msgid "A webhook secret is already configured. Leave this field blank to keep it unchanged."
msgstr "È già configurato un segreto webhook. Lascia vuoto questo campo per mantenerlo invariato."

msgid "Create a webhook in BTCPay Server and enter its secret here."
msgstr "Crea un webhook in BTCPay Server e inserisci qui il relativo segreto."

msgid "Webhook URL"
msgstr "URL del webhook"

msgid "Configure this URL in BTCPay Server for the InvoiceSettled, InvoiceExpired and InvoiceInvalid events."
msgstr "Configura questo URL in BTCPay Server per gli eventi InvoiceSettled, InvoiceExpired e InvoiceInvalid."

msgid "Click \"Complete Order\" to proceed to BTCPay Server."
msgstr "Fai clic su «Completa ordine» per procedere a BTCPay Server."
