msgid "BTCPay Server payment method for Community Store."
msgstr "Mode de paiement BTCPay Server pour Community Store."

msgid "BTCPay Server Payment Method"
msgstr "Mode de paiement BTCPay Server"

msgid "Not configured"
msgstr "Non configuré"

msgid "BTCPay Server URL must be set."
msgstr "L’URL de BTCPay Server doit être renseignée."

msgid "BTCPay Server URL must be a valid URL."
msgstr "L’URL de BTCPay Server doit être une URL valide."

msgid "BTCPay Server Store ID must be set."
msgstr "L’identifiant du magasin BTCPay Server doit être renseigné."

msgid "BTCPay Server API key must be set."
msgstr "La clé API de BTCPay Server doit être renseignée."

msgid "BTCPay Server webhook secret must be set."
msgstr "Le secret du webhook BTCPay Server doit être renseigné."

msgid "Community Store currency must be configured before enabling BTCPay Server."
msgstr "La devise de Community Store doit être configurée avant d’activer BTCPay Server."

msgid "Unable to start the BTCPay Server payment. Please return to checkout and try again."
msgstr "Impossible de démarrer le paiement BTCPay Server. Revenez à la commande et réessayez."

#, php-format
msgid "Payments use the Community Store currency: %s. Currency conversion is not performed by this payment method."
msgstr "Les paiements utilisent la devise configurée dans Community Store : %s. Ce mode de paiement n’effectue aucune conversion de devise."

msgid "BTCPay Server URL"
msgstr "URL de BTCPay Server"

msgid "BTCPay Server Store ID"
msgstr "Identifiant du magasin BTCPay Server"

msgid "BTCPay Server API key"
msgstr "Clé API de BTCPay Server"

msgid "An API key is already configured. Leave this field blank to keep it unchanged."
msgstr "Une clé API est déjà configurée. Laissez ce champ vide pour la conserver sans modification."

msgid "Enter an API key that can create and view invoices for this BTCPay Server store."
msgstr "Saisissez une clé API autorisée à créer et consulter les factures de ce magasin BTCPay Server."

msgid "BTCPay Server webhook secret"
msgstr "Secret du webhook BTCPay Server"

msgid "A webhook secret is already configured. Leave this field blank to keep it unchanged."
msgstr "Un secret de webhook est déjà configuré. Laissez ce champ vide pour le conserver sans modification."

msgid "Create a webhook in BTCPay Server and enter its secret here."
msgstr "Créez un webhook dans BTCPay Server et saisissez son secret ici."

msgid "Webhook URL"
msgstr "URL du webhook"

msgid "Configure this URL in BTCPay Server for the InvoiceSettled, InvoiceExpired and InvoiceInvalid events."
msgstr "Configurez cette URL dans BTCPay Server pour les événements InvoiceSettled, InvoiceExpired et InvoiceInvalid."

msgid "Click \"Complete Order\" to proceed to BTCPay Server."
msgstr "Cliquez sur « Terminer la commande » pour poursuivre vers BTCPay Server."
